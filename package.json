{
  "name": "pointcloud-lod",
  "version": "0.0.0-development",
  "description": "Octree LOD point-cloud streaming for vtk.js",
  "keywords": [
    "copc",
    "lod",
    "octree",
    "point-cloud",
    "streaming",
    "vtk",
    "vtk.js",
    "webgl"
  ],
  "homepage": "https://github.com/PaulHax/pointcloud-lod#readme",
  "bugs": {
    "url": "https://github.com/PaulHax/pointcloud-lod/issues"
  },
  "license": "MIT",
  "author": "Paul Elliott",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulHax/pointcloud-lod.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "vtkjs-fork.env"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vtk": {
      "types": "./dist/rendererAdapter.d.ts",
      "import": "./dist/rendererAdapter.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p examples/vtk/tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "example": "vite --config examples/vtk/vite.config.ts",
    "example:build": "vite build --config examples/vtk/vite.config.ts",
    "test:browser": "npm run example:build && vitest run --config vitest.browser.config.ts",
    "test:perf": "npm run example:build && vitest run --config vitest.perf.config.ts",
    "telemetry:capture": "POINTCLOUD_LOD_BROWSER_GPU=1 npm run test:perf -- test/browser/telemetry-capture.perf.spec.ts",
    "verify:chain": "node scripts/verifyChain.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "copc": "^0.0.8"
  },
  "devDependencies": {
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.0",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.0",
    "semantic-release": "^25.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
