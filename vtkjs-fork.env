# The vtk.js build the renderer adapter requires.
#
# `vtkPointGaussianMapper` exists in no released @kitware/vtk.js, so the adapter
# can only run against this fork. A branch name would not pin anything — it
# moves — so the requirement is a commit; the branch only records where to find
# it.
#
# This is the only place the sha is written: README.md points here, and CI
# builds and tests the example against exactly this commit.
VTKJS_FORK_REPO=https://github.com/PaulHax/vtk-js.git
VTKJS_FORK_BRANCH=pointcloud-array-streaming-prototype
VTKJS_FORK_COMMIT=6483557612b1b6b9341a7f6eece1a82ae740b002
